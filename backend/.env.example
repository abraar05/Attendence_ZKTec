# Server
PORT=5000
NODE_ENV=production

# Database (Postgres - free options: Supabase, Neon, Render, or local Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ZKTeco device polling (fallback / heartbeat, in addition to live push)
DEVICE_POLL_INTERVAL_MINUTES=5

# CORS
FRONTEND_URL=http://localhost:5173
